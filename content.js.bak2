// [크로스 브라우징] 네임스페이스 통일
const extBrowser = window.browser || window.chrome;

// 5분 간격으로 세션을 연장하는 주기 상수 (ms)
const KEEP_ALIVE_INTERVAL = 5 * 60 * 1000;

// 세션 유지 인터벌의 ID를 보관하는 변수 (나중에 중지할 때 필요)
let sessionIntervalId = null;

// 플로팅 UI DOM 요소를 참조할 변수
let floatingBtn = null;
let panel = null;

// 현재 페이지의 호스트네임
const currentHostname = window.location.hostname;

/**
 * 5분마다 현재 사이트의 루트 경로로 GET 요청을 보내어 세션 만료를 방지합니다.
 * 이 함수는 setInterval을 통해 주기적으로 호출됩니다.
 */
function extendSession() {
    // 잠재적 취약점 방지: 현재 URL 그대로 fetch 시 쿼리 파라미터로 인한 의도치 않은 액션 방지를 위해 원점(origin)으로 요청
    const safeUrl = window.location.origin + "/";
    fetch(safeUrl, {
        method: "GET",
        credentials: "include" // 로그인 세션 쿠키를 함께 보내기 위해 필수
    }).catch((err) => {
        console.error("Always: 세션 연장 요청 실패", err);
    });
}

/**
 * 세션 유지를 시작합니다. 인터벌을 등록하고 UI를 활성화합니다.
 */
function startKeepAlive() {
    // 이미 실행 중이면 중복 실행 방지
    if (sessionIntervalId !== null) return;
    
    console.log(`Always: ${currentHostname} 사이트 세션 유지 시작됨.`);
    sessionIntervalId = setInterval(extendSession, KEEP_ALIVE_INTERVAL);
    
    // UI 렌더링
    renderUI();
}

/**
 * 세션 유지를 중지합니다. 인터벌을 해제하고 UI를 제거합니다.
 */
function stopKeepAlive() {
    if (sessionIntervalId !== null) {
        clearInterval(sessionIntervalId);
        sessionIntervalId = null;
        console.log(`Always: ${currentHostname} 사이트 세션 유지 중지됨.`);
    }
    
    // UI 제거
    removeUI();
}

/**
 * 플로팅 버튼(FAB) UI를 화면 우측 하단에 생성하여 주입합니다.
 * 이 함수는 현재 사이트가 세션 유지 대상(activeSites)일 때 호출되어야 합니다.
 */
function renderUI() {
    if (document.getElementById('always-ext-root')) return; // 이미 존재하면 무시
    
    const root = document.createElement('div');
    root.id = 'always-ext-root';
    
    // 플로팅 아이콘
    floatingBtn = document.createElement('div');
    floatingBtn.id = 'always-ext-fab';
    floatingBtn.className = 'is-active';
    floatingBtn.innerHTML = 'A'; // Always 의 A
    floatingBtn.title = 'Always 세션 유지 동작 중';
    
    // 간단한 패널 (사용자가 어떤 툴인지 인지할 수 있도록)
    panel = document.createElement('div');
    panel.id = 'always-ext-panel';
    panel.innerHTML = `
        <div class="always-ext-header">
            <h3 class="always-ext-title">Always</h3>
            <button class="always-ext-close" id="always-ext-close-btn">&times;</button>
        </div>
        <div class="always-ext-status-text">
            현재 사이트의 세션이 자동 연장되고 있습니다. (5분 주기)
        </div>
    `;
    
    // 아이콘 클릭 시 패널 토글
    floatingBtn.addEventListener('click', () => {
        if (panel.style.display === 'flex') {
            panel.style.display = 'none';
        } else {
            panel.style.display = 'flex';
        }
    });
    
    root.appendChild(panel);
    root.appendChild(floatingBtn);
    document.body.appendChild(root);
    
    // 패널 닫기 버튼 이벤트
    document.getElementById('always-ext-close-btn').addEventListener('click', () => {
        panel.style.display = 'none';
    });
}

/**
 * 화면에서 플로팅 버튼 UI를 완전히 제거합니다.
 * 이 함수는 세션 유지가 꺼질 때 호출되어야 합니다.
 */
function removeUI() {
    const root = document.getElementById('always-ext-root');
    if (root) {
        root.remove();
        floatingBtn = null;
        panel = null;
    }
}

/**
 * 초기화 함수: 스토리지에서 등록된 사이트 목록을 불러와 현재 호스트네임이 포함되어 있는지 확인합니다.
 */
function init() {
    extBrowser.storage.sync.get(['always_sites'], (result) => {
        const sitesArray = result.always_sites || [];
        const activeSites = new Set(sitesArray);
        
        if (activeSites.has(currentHostname)) {
            startKeepAlive();
        }
    });
}

// 스토리지 변경 사항(예: 팝업에서 사용자가 토글) 실시간 감지
extBrowser.storage.onChanged.addListener((changes, namespace) => {
    if (namespace === 'sync' && changes.always_sites) {
        const newSitesArray = changes.always_sites.newValue || [];
        const newActiveSites = new Set(newSitesArray);
        
        if (newActiveSites.has(currentHostname)) {
            startKeepAlive();
        } else {
            stopKeepAlive();
        }
    }
});

// 스크립트 실행 시 초기화 시작
init();